# Google Gemini API key — create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by the planner, writers and reviewer (any Gemini model that supports Google Search grounding)
GEMINI_MODEL=gemini-2.5-flash
# Optional: a different (e.g. cheaper/faster) model just for the parallel researchers
# GEMINI_RESEARCH_MODEL=gemini-2.5-flash-lite

# Max simultaneous Gemini calls across all parallel workers (lower this if you hit 429 rate limits)
SCRIPTORIUM_CONCURRENCY=4
# Reviewer score (1-10) a draft needs to finish without another revision round
SCRIPTORIUM_PASS_SCORE=8

# Folders
# SCRIPTORIUM_DATA_DIR=./data
# SCRIPTORIUM_OUTPUT_DIR=./output
# PORT=3000
