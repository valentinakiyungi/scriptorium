{
  "name": "scriptorium",
  "version": "1.0.0",
  "description": "Autonomous multi-agent research & document drafting system — a LangGraph Supervisor-Worker pipeline powered by Google Gemini.",
  "type": "module",
  "bin": {
    "scriptorium": "bin/scriptorium.mjs"
  },
  "scripts": {
    "scriptorium": "tsx src/cli.ts",
    "draft": "tsx src/cli.ts draft",
    "types": "tsx src/cli.ts types",
    "web": "tsx src/cli.ts web",
    "demo": "tsx src/cli.ts web --mock",
    "bench": "tsx src/cli.ts bench",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["langgraph", "gemini", "multi-agent", "supervisor", "research", "rag", "llm", "document-generation"],
  "author": "Valentina Kiyungi",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.8",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
